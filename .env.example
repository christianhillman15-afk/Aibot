# --- Required ---------------------------------------------------------------
# Anthropic API key (console.anthropic.com -> API keys). Pay-as-you-go billing.
ANTHROPIC_API_KEY=

# Access token for the web UI. Generate one with: openssl rand -hex 24
AUTH_TOKEN=

# --- Model ------------------------------------------------------------------
# claude-fable-5 ($10/$50 per MTok) — or claude-opus-4-8 ($5/$25) to halve costs.
MODEL=claude-fable-5
# When Fable 5's safety classifiers decline a request, retry it on this model
# automatically (server-side fallback). Set FALLBACKS=off to disable.
FALLBACK_MODEL=claude-opus-4-8
FALLBACKS=on

# --- Behavior ---------------------------------------------------------------
# Reasoning depth: low | medium | high | xhigh | max
DEFAULT_EFFORT=high
ULTRA_EFFORT=xhigh
SUBAGENT_EFFORT=medium
# Max parallel subagents in Ultra mode (each one costs tokens!)
MAX_SUBAGENTS=6

# --- Server -----------------------------------------------------------------
PORT=8080
# Uncomment ONLY if the port is firewalled to localhost:
# ALLOW_NO_AUTH=1
