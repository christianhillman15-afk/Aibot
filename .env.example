# --- Required ---------------------------------------------------------------
# Replicate API token — this is what gets billed for every generation.
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Access token for the web UI. Generate with: openssl rand -hex 24
AUTH_TOKEN=

# --- Models (cheap-but-good defaults; swap any for a premium model) ---------
# Video (cinematic clips, shorts, explainer scenes):
MODEL_T2V=wan-video/wan-2.5-t2v
MODEL_I2V=wan-video/wan-2.5-i2v
#   Premium swaps: google/veo-3.1  ·  kwaivgi/kling-v3-video  ·  bytedance/seedance-2.0
#   (Veo/Kling/Seedance look better and add native audio, but cost more per clip.)
# Voiceover (explainer + talking avatar):
MODEL_TTS=jaaari/kokoro-82m
#   Premium swap with voice cloning: minimax/speech-2.8-hd
TTS_VOICE=af_heart
# Talking avatar (portrait + voice -> talking video):
MODEL_AVATAR=bytedance/omni-human
# Lip-sync (reserved for future use):
MODEL_LIPSYNC=sync/lipsync-2
# 4K upscaler (used by the "Upscale to 4K" toggle):
MODEL_UPSCALE=topazlabs/video-upscale
# Extra input for the upscaler. The target-resolution key varies by model —
# adjust if 4K doesn't take (the exact error shows in the UI).
UPSCALE_INPUT_JSON={"target_resolution":"4k"}

# --- Behavior ---------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
MAX_SCENES=8
POLL_TIMEOUT_MS=900000
BODY_LIMIT_MB=60
# Stitching: to reach a target duration longer than one generation, the app
# makes N segments of this length and concatenates them (each continues from the
# previous clip's last frame). e.g. 15s target / 5s segment = 3 stitched clips.
CLIP_SEGMENT_SECONDS=5
MAX_TARGET_SECONDS=20

# Rough cost estimates shown in the UI (USD). Edit to match your chosen models.
COST_T2V=0.25
COST_I2V=0.25
COST_TTS=0.02
COST_AVATAR=0.5
COST_UPSCALE=0.5
# Live cost: Replicate reports actual compute seconds per run; this $/second
# rate converts that to the "actual" figure shown after a job. Hardware-
# dependent — tune to your models for accuracy.
COST_PER_COMPUTE_SEC=0.0012

# --- Server -----------------------------------------------------------------
PORT=8080
# Uncomment ONLY if the port is firewalled to localhost:
# ALLOW_NO_AUTH=1
